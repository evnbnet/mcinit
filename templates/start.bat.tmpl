@echo off
rem ===========================================================================
rem  Generated by mcinit {{.McinitVersion}} on {{.Generated}}
rem  {{.Software}} {{.MCVersion}} (build {{.Build}}) with {{.RAM}} GB of RAM
rem
rem  The GC settings are Aikar's flags, the recommended tuning for Paper
rem  servers: https://docs.papermc.io/paper/aikars-flags
rem ===========================================================================
setlocal
cd /d "%~dp0"

rem Absolute path to Java. The full path is used on purpose: a freshly
rem installed Java only shows up in the PATH of new terminals, so relying on a
rem bare "java" would break the very first start.
set "JAVA={{.JavaPath}}"

if not exist "%JAVA%" (
  echo.
  echo  Java was not found at:
  echo    %JAVA%
  echo.
  echo  If you moved or uninstalled it, create the server again with:
  echo    mcinit new {{.Name}}
  echo.
  pause
  exit /b 1
)

set "HEAP=-Xms{{.RAM}}G -Xmx{{.RAM}}G"
{{- if .VectorModule}}
rem Speeds up Paper's chunk generator. Needs Java 9 or newer.
set "HEAP=%HEAP% --add-modules=jdk.incubator.vector"
{{- end}}
set "GC=-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200"
set "GC=%GC% -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch"
set "GC=%GC% -XX:G1NewSizePercent={{.G1NewSizePercent}} -XX:G1MaxNewSizePercent={{.G1MaxNewSizePercent}}"
set "GC=%GC% -XX:G1HeapRegionSize={{.G1HeapRegionSize}} -XX:G1ReservePercent={{.G1ReservePercent}}"
set "GC=%GC% -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4"
set "GC=%GC% -XX:InitiatingHeapOccupancyPercent={{.InitiatingHeapOccupancyPercent}}"
set "GC=%GC% -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5"
set "GC=%GC% -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1"
set "GC=%GC% -Dusing.aikars.flags=https://mcflags.emc.gs -Daikars.new.flags=true"

"%JAVA%" %HEAP% %GC% -jar "{{.JarName}}" nogui

echo.
echo  The server stopped.
pause
