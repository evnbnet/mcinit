#!/bin/sh
# ===========================================================================
#  Generated by mcinit {{.McinitVersion}} on {{.Generated}}
#  {{.Software}} {{.MCVersion}} (build {{.Build}}) with {{.RAM}} GB of RAM
#
#  The GC settings are Aikar's flags, the recommended tuning for Paper
#  servers: https://docs.papermc.io/paper/aikars-flags
#
#  Named .command so Finder runs it on a double click. From a terminal it is
#  ./start.command like any other script.
# ===========================================================================
# Deliberately no "set -e". The whole point of the prompt at the end is to keep
# the window open when the server dies, and set -e would exit before reaching
# it — closing the window on exactly the crash the user needs to read.

# Run from the server folder, however the script was launched. Finder starts
# scripts in the home directory, not next to the file.
cd "$(dirname "$0")" || exit 1

# Absolute path to Java. The full path is used on purpose: a freshly installed
# Java only shows up in the PATH of new shells, so relying on a bare "java"
# would break the very first start.
JAVA="{{.JavaPath}}"

if [ ! -x "$JAVA" ]; then
  echo
  echo "  Java was not found at:"
  echo "    $JAVA"
  echo
  echo "  If you moved or uninstalled it, create the server again with:"
  echo "    mcinit new {{.Name}}"
  echo
  read -r _unused
  exit 1
fi

HEAP="-Xms{{.RAM}}G -Xmx{{.RAM}}G"
{{- if .VectorModule}}
# Speeds up Paper's chunk generator. Needs Java 9 or newer.
HEAP="$HEAP --add-modules=jdk.incubator.vector"
{{- end}}
GC="-XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200"
GC="$GC -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:+AlwaysPreTouch"
GC="$GC -XX:G1NewSizePercent={{.G1NewSizePercent}} -XX:G1MaxNewSizePercent={{.G1MaxNewSizePercent}}"
GC="$GC -XX:G1HeapRegionSize={{.G1HeapRegionSize}} -XX:G1ReservePercent={{.G1ReservePercent}}"
GC="$GC -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4"
GC="$GC -XX:InitiatingHeapOccupancyPercent={{.InitiatingHeapOccupancyPercent}}"
GC="$GC -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5"
GC="$GC -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1"
GC="$GC -Dusing.aikars.flags=https://mcflags.emc.gs -Daikars.new.flags=true"

# Word splitting is wanted here: HEAP and GC are lists of arguments.
# shellcheck disable=SC2086
"$JAVA" $HEAP $GC -jar "{{.JarName}}" nogui
status=$?

echo
if [ "$status" -ne 0 ]; then
  echo "  The server stopped with an error (exit $status)."
else
  echo "  The server stopped."
fi
# Keep the window open when launched from Finder, so a crash stays readable.
read -r _unused
exit "$status"
